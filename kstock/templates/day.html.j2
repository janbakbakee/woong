<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>국장 수급 TOP — {{ day.date|label }}</title>
<style>
  body{margin:0;background:#f5f6f8;color:#1b1d21;font:14px/1.5 -apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif}
  main{max-width:760px;margin:0 auto;padding:12px 16px 40px}
  h1{font-size:19px;margin:8px 0 4px} h2{font-size:17px;margin:22px 0 8px}
  .muted{color:#6b7280;font-size:12px}
  .tabs{display:flex;gap:6px;overflow-x:auto;padding:8px 0;margin:0 -16px;padding-left:16px}
  .tabs a{flex:none;padding:5px 10px;border-radius:14px;background:#fff;border:1px solid #d9dce1;color:#1b1d21;text-decoration:none;font-size:13px}
  .tabs a.on{background:#1b1d21;color:#fff;border-color:#1b1d21}
  .box{background:#fff;border:1px solid #e3e5e8;border-radius:10px;padding:10px 12px;margin:8px 0}
  table{border-collapse:collapse;width:100%;font-size:13px}
  th,td{padding:5px 4px;text-align:right;border-bottom:1px solid #eef0f2;white-space:nowrap}
  th:first-child,td:first-child,th:nth-child(2),td:nth-child(2){text-align:left}
  .scroll{overflow-x:auto}
  .up{color:#d62d2d}.down{color:#1f5fd1}
  details{background:#fff;border:1px solid #e3e5e8;border-radius:10px;margin:8px 0}
  summary{padding:10px 12px;cursor:pointer;list-style:none}
  summary::-webkit-details-marker{display:none}
  .card{padding:0 12px 12px}
  .score{font-weight:700;font-size:18px;float:right}
  .bar{height:8px;background:#eef0f2;border-radius:4px;overflow:hidden;margin:2px 0 6px}
  .bar i{display:block;height:100%;background:#1b1d21}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:6px 12px;font-size:13px}
  .tag{display:inline-block;padding:1px 7px;border-radius:9px;background:#eef0f2;font-size:12px;margin:2px 2px 0 0}
  .warn{background:#fff3e0;color:#9a5300}
  a{color:#1f5fd1}
</style>
</head>
<body><main>
<h1>📈 국장 수급 TOP — {{ day.date|label }} 장 마감</h1>
<div class="muted">외국인·기관(금융투자 제외) 순매수 + 거래량·캔들 + 추세·위치 + 재무 · 관찰 후보 (매수 신호 아님) · 배점은 검증 전 가설</div>
<nav class="tabs">{% for t in tabs %}<a href="{{ t }}.html" class="{{ 'on' if t == day.date }}">{{ t|label }}</a>{% endfor %}</nav>

{% for m, mk in day.markets.items() %}{% set h = hist[m] %}
<h2 id="{{ m|lower }}">{{ mk.light }} {{ m }} <span class="muted">{{ "%.2f"|format(mk.close) }} ({{ mk.chg|pct }}) · 20일선 {{ '위' if mk.above_ma20 else '아래' }}</span></h2>
<div class="muted">스캔 {{ day.stats.scanned }} · 조건 통과 {{ day.stats.passed[m] }}{% if day.stats.errors %} · 조회 실패 {{ day.stats.errors }}{% endif %}{% if day.stats.stale %} · 기준일 불일치 {{ day.stats.stale }}{% endif %}{% if not day.dart %} · DART 미연결(공시 미검증){% endif %}</div>
{% if h.exits %}<div class="box">🚪 전일 TOP에서 이탈: {{ h.exits|join(", ") }} <span class="muted">— 수급 꺾임 여부 확인</span></div>{% endif %}

<div class="box scroll"><table>
<tr><th>#</th><th>종목</th><th>점수</th><th>현재가</th><th>등락</th><th>외인5일</th><th>기관5일</th><th>등장</th><th>목표가</th></tr>
{% for p in mk.picks %}{% set s = h.seen.get(p.code) %}
<tr><td>{{ p.rank }}</td><td><a href="#{{ p.code }}">{{ p.name }}</a></td><td>{{ p.score }}</td><td>{{ p.close|num }}</td>
<td class="{{ 'up' if p.chg > 0 else 'down' if p.chg < 0 }}">{{ p.chg|pct }}</td><td>{{ p.frgn5|eok }}</td><td>{{ p.orgn5|eok }}</td>
<td>{{ s.count if s else 1 }}/{{ h.window }}</td><td>{% if p.opinion %}{{ p.opinion.upside|pct }}{% else %}-{% endif %}</td></tr>
{% endfor %}
</table>{% if not mk.picks %}<div class="muted">조건을 충족한 종목이 없습니다.</div>{% endif %}</div>

{% for p in mk.picks %}{% set s = h.seen.get(p.code) %}
<details id="{{ p.code }}" {{ 'open' if p.rank == 1 }}>
<summary><span class="score">{{ p.score }}</span><b>{{ p.rank }}) {{ p.name }}</b> <span class="muted">{{ p.code }} · 시총 {{ p.mcap|num }}억</span><br>
<span class="{{ 'up' if p.chg > 0 else 'down' if p.chg < 0 }}">{{ p.close|num }}원 ({{ p.chg|pct }})</span>
{% if s and s.count > 1 %}<span class="tag">🔁 {{ h.window }}일 중 {{ s.count }}일 · 첫 등장 {{ s.first|label }} 대비 {{ ((p.close / s.first_close - 1) * 100)|pct }}</span>{% else %}<span class="tag">🆕 신규</span>{% endif %}
{% if p.ext_atr > 3.5 %}<span class="tag warn">⚠️ 단기 과열</span>{% endif %}{% if p.flags %}<span class="tag warn">⚠️ 악재 뉴스 {{ p.flags|length }}</span>{% endif %}
</summary>
<div class="card">
<div><a href="https://m.stock.naver.com/domestic/stock/{{ p.code }}/total">네이버증권 모바일</a> · <a href="https://finance.naver.com/item/main.naver?code={{ p.code }}">네이버증권 PC</a></div>

<div class="box"><b>현재가</b> {{ p.close|num }}원 <span class="muted">({{ day.date|label }} 종가)</span><br>
<b>목표가</b> {% if p.opinion %}{{ p.opinion.avg|num }}원 <span class="{{ 'up' if p.opinion.upside > 0 else 'down' }}">({{ p.opinion.upside|pct }})</span>
<span class="muted">— 최근 리포트 {{ p.opinion.n }}건 평균 · {{ p.opinion.from|label }} ~ {{ p.opinion.to|label }} · 출처: KIS 종목투자의견</span>
<div class="muted">{% for o in p.opinion.latest %}{{ o.date|label }} {{ o.broker or '증권사 미표기' }} {{ o.opinion }} {{ o.target|num }}원{% if not loop.last %} · {% endif %}{% endfor %}</div>
{% else %}<span class="muted">최근 3개월 리포트 없음</span>{% endif %}</div>

{{ chart(p.series)|safe }}

<div class="box">
{% for k, mx in parts_max.items() %}<div>{{ k }} <b>{{ p.parts.get(k, 0) }}</b><span class="muted">/{{ mx }}</span></div>
<div class="bar"><i style="width:{{ (p.parts.get(k, 0) / mx * 100)|round }}%"></i></div>{% endfor %}
{% if p.parts.get('뉴스') %}<div class="up">뉴스 감점 {{ p.parts['뉴스'] }}</div>{% endif %}
<div class="grid">
<div>5일 외인 <b>{{ p.frgn5|eok }}</b></div><div>5일 기관(금투제외) <b>{{ p.orgn5|eok }}</b></div>
<div>연기금·투신·사모 5일 <b>{{ p.quality5|eok }}</b></div><div>20일 누적 ÷ 시총 <b>{{ "%.2f"|format(p.flow20_pct) }}%</b></div>
<div>쌍끌이 <b>{{ p.streak }}일</b> · 외인 {{ p.frgn_streak }}일 · 연기금 {{ p.fund_streak }}일</div>
<div>거래량 <b>{{ "%.1f"|format(p.vol_ratio) }}배</b> (20일 평균 대비)</div>
<div>종가 위치 <b>{{ (p.clv * 100)|round|int }}%</b> · 윗꼬리 {{ (p.upper_wick * 100)|round|int }}%</div>
<div>20일선 이격 <b>{{ p.disparity|pct }}</b> (ATR {{ "%.1f"|format(p.ext_atr) }}배)</div>
<div>지수 대비 20일 <b>{% if p.rs20 is none %}미검증{% else %}{{ "%+.1f"|format(p.rs20) }}%p{% endif %}</b></div>
<div>{{ '20일선 위' if p.above_ma20 else '20일선 아래' }} · {{ '정배열' if p.ma_aligned else '역배열' }}{{ ' · 고점 근접' if p.near_high }}</div>
<div>영업이익 <b>{{ '흑자' if p.op_profit > 0 else '적자' }}</b> · ROE {{ p.roe }}</div>
</div></div>

<div class="box scroll"><b>최근 20일 순매수 (억원)</b>
<table><tr><th>날짜</th><th></th><th>종가</th><th>외국인</th><th>기관</th><th>연기금</th><th>투신</th></tr>
{% for r in p.series[-20:]|reverse %}<tr><td>{{ r.d[4:6] }}/{{ r.d[6:] }}</td><td></td><td>{{ r.c|num }}</td>
<td class="{{ 'up' if r.f > 0 else 'down' if r.f < 0 }}">{{ "%+.0f"|format(r.f) }}</td><td class="{{ 'up' if r.i > 0 else 'down' if r.i < 0 }}">{{ "%+.0f"|format(r.i) }}</td>
<td>{{ "%+.0f"|format(r.fund) }}</td><td>{{ "%+.0f"|format(r.ivtr) }}</td></tr>{% endfor %}
</table></div>

{% if p.news %}<div class="box"><b>뉴스</b>{% for t, u in p.news %}<div>{{ '⚠️' if t in p.flags else '📰' }} <a href="{{ u }}">{{ t }}</a></div>{% endfor %}</div>{% endif %}
</div></details>
{% endfor %}
{% endfor %}
<p class="muted">생성 {{ generated }} · 최근 {{ tabs|length }}거래일 보관 · 데이터: 한국투자증권 Open API, Google News{% if day.dart %}, DART{% endif %}</p>
</main></body></html>
